---
import { SEO } from "astro-seo";
import Footer from "../components/footer.astro";
import Navbar from "../components/navbar/navbar.astro";
import "@fontsource/inter/variable.css";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
}

const canonicalURL = new URL(Astro.url.href, Astro.site).toString();

const { title, description } = Astro.props;

const makeTitle = title ? `${title} | Autoškola Hlaváček` : "Autoškola Hlaváček";
const pageDescription =
  description ??
  "Autoškola Hlaváček ve Vlašimi nabízí výuku a výcvik řidičů skupin A2, A a B.";
---

<style>
  .bg {
    position: relative;
    overflow: auto; /* Enable scrolling for the content */

    background-image: linear-gradient(
      95.2deg,
      rgb(225, 247, 241) 26.8%,
      rgb(248, 225, 207) 84%
    );
    background-size: cover;
    background-position: center;
  }
</style>

<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={makeTitle}
      description={pageDescription}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: makeTitle,
          image: "",
        },
        image: {
          alt: "Autoškola Hlaváček",
        },
      }}
    />
    <meta property="og:description" content={pageDescription} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={makeTitle} />
    <meta name="twitter:description" content={pageDescription} />
  </head>
  <body class="bg">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:px-4 focus:py-3 focus:text-black focus:shadow-lg">
      Přeskočit na obsah
    </a>
    <Navbar />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <style is:global>
      img {
        content-visibility: auto;
      }
      html {
        scrollbar-gutter: stable;
      }
    </style>
  </body>
</html>
