---
import { Image } from "astro:assets";
import lubos from "../assets/LubosHlavacek.jpg";

import ImageGallery from "../components/ImageGallery.astro";
import Container from "../components/container.astro";
import Features from "../components/features.astro";
import Hero from "../components/hero.astro";
import Layout from "../layouts/Layout.astro";

const publishedTeamMembers = [
  {
    data: {
      draft: false,
      name: "Luboš Hlaváček",
      title: "Vedoucí učitel a instruktor",
      avatar: {
        src: lubos,
        alt: "Luboš Hlaváček",
      },
    },
  },
];
---

<Layout
  title="Autoškola Hlaváček"
  description="Autoškola Hlaváček ve Vlašimi nabízí výuku a výcvik řidičů skupin A2, A, B, B-automat, B96 a B+E."
>
  <Container>
    <!-- Hero sekce -->
    <Hero />

    <!-- Sekce O nás + tým -->
    <section id="team" class="mt-12">
      <div>
        <h2 class="mb-4 text-3xl font-bold text-gray-800">Náš tým</h2>
        <p class="text-lg leading-relaxed text-slate-500">
          Autoškola Luboš Hlaváček je tým zkušených učitelů, kteří společně zajišťují výuku a praktický výcvik pro získání řidičského oprávnění skupin A2, A, B, B-automat, B96 a B+E. Každý člen týmu přináší vlastní zkušenosti a individuální přístup, díky kterému dokážeme výuku přizpůsobit různým potřebám našich žáků. Dbáme na srozumitelnou teorii, klidný průběh jízd a individuální přístup ke každému. Naším cílem je připravit vás nejen na zkoušku, ale především na bezpečnou a sebejistou samostatnou jízdu.
        </p>
      </div>
      <div
        class="mx-auto mt-12 max-w-md">
        {
          publishedTeamMembers.map((teamMemberEntry) => (
            <article class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
              <div class="aspect-square w-full">
                <Image
                  quality="high"
                  src={teamMemberEntry.data.avatar.src}
                  alt={teamMemberEntry.data.avatar.alt}
                  width={640}
                  height={640}
                  sizes="(max-width: 640px) 100vw, 640px"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />
              </div>
              <div class="px-6 py-5 text-left">
                <h3 class="text-2xl font-bold text-gray-900">
                  {teamMemberEntry.data.name}
                </h3>
                <p class="mt-1 text-base font-medium text-blue-700">
                  {teamMemberEntry.data.title}
                </p>
                <p class="mt-3 text-sm leading-relaxed text-slate-500">
                  Provází žáky výukou a praktickým výcvikem s důrazem na
                  bezpečnost, klid a jistotu za volantem i řídítky.
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Provozní doba -->
    <section id="office-info" class="mt-12">
      <div class="flex flex-col mx-auto">
        <h2 class="font-bold text-3xl text-gray-800 mb-4"> Provozní doba kanceláře</h2>
        <p class="text-lg leading-relaxed text-slate-500">
          Upozornění: Provozní doba se může ve výjimečných případech změnit. Pokud bude kancelář dočasně uzavřená, volejte nebo pište e-mail dle kontaktů uvedených v sekci Kontakty.
        </p>
      </div>

      <div class="mx-auto max-w-xl mt-12 overflow-x-auto shadow-md sm:rounded-lg bg-white p-4">
        <table class="table-auto w-auto mx-auto text-sm text-gray-600">
          <thead class="text-xs uppercase bg-gray-50 text-gray-600">
            <tr>
              <th scope="col" class="px-6 py-3 font-semibold text-gray-800">
                Den
              </th>
              <th scope="col" class="px-6 py-3 font-semibold text-gray-800">
                Otevřeno
              </th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b">
              <th scope="row" class="px-6 py-4 font-semibold text-gray-800 whitespace-nowrap">
                Pondělí
              </th>
              <td class="px-6 py-4">9:00 – 12:00, 12:30 – 15:30</td>
            </tr>
            <tr class="border-b">
              <th scope="row" class="px-6 py-4 font-semibold text-gray-800 whitespace-nowrap">
                Úterý
              </th>
              <td class="px-6 py-4">9:00 – 12:00, 12:30 – 15:30</td>
            </tr>
            <tr class="border-b">
              <th scope="row" class="px-6 py-4 font-semibold text-gray-800 whitespace-nowrap">
                Středa
              </th>
              <td class="px-6 py-4">9:00 – 12:00, 12:30 – 16:30</td>
            </tr>
            <tr class="border-b">
              <th scope="row" class="px-6 py-4 font-semibold text-gray-800 whitespace-nowrap">
                Čtvrtek
              </th>
              <td class="px-6 py-4">9:00 – 12:00, 12:30 – 15:30</td>
            </tr>
            <tr>
              <th scope="row" class="px-6 py-4 font-semibold text-gray-800 whitespace-nowrap">
                Pátek
              </th>
              <td class="px-6 py-4">9:00 – 12:00, 12:30 – 16:00</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Další informace (Features) -->
    <Features />

    <!-- Galerie -->
    <ImageGallery galleryText="Krátká ukázka z naší autoškoly" />
  </Container>
</Layout>
