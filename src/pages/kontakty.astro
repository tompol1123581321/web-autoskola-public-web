---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import Sectionhead from "../components/sectionhead.astro";
---

<Layout title="Kontakty">
  <Container>
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div>
        <Sectionhead>
          <Fragment slot="title">Kontakty</Fragment>
        </Sectionhead>
        <div
          class="px-4 py-16 mx-auto max-w-6xl lg:px-8 lg:py-20 bg-primary-50">
          <div class="grid mx-auto space-y-6 md:grid-cols-2 md:space-y-0">
            <div class="sm:px-8">
              <div class="flex max-w-md flex-col gap-4 sm:flex-row">
                <div class="shrink-0">
                  <div
                    class="flex items-center justify-center w-12 h-12 rounded-full bg-primary-500">
                    <Icon name="tabler:home" class="w-7 h-7 text-slate-900" />
                  </div>
                </div>
                <div class="min-w-0 space-y-1">
                  <h3 class="mb-3 text-xl font-bold">Kde nás najdete</h3>
                  <p>Autoškola Luboš Hlaváček</p>
                  <p>Komenského 40</p>
                  <p>258 01 Vlašim, okr. Benešov u Prahy</p>
                </div>
              </div>
            </div>
            <div class="sm:px-8">
              <div class="flex max-w-md flex-col gap-4 sm:flex-row">
                <div class="shrink-0">
                  <div
                    class="flex items-center justify-center w-12 h-12 rounded-full bg-primary-500">
                    <Icon name="tabler:phone" class="w-7 h-7 text-slate-900" />
                  </div>
                </div>
                <div class="min-w-0 space-y-4">
                  <h3 class="mb-3 text-xl font-bold">Kontaktní údaje</h3>
                  <div>
                    <h5><b>Kancelář:</b></h5>
                    <ul class="ml-4">
                      <li><a class="underline hover:text-blue-700" href="tel:+420603928674">603 928 674</a></li>
                      <li><a class="underline hover:text-blue-700" href="tel:+420604848151">604 848 151</a></li>
                    </ul>
                  </div>
                  <div>
                    <h5><b>Učitelé:</b></h5>
                    <ul class="ml-4">
                      <li>Luboš Hlaváček - <a class="block underline hover:text-blue-700 sm:inline" href="tel:+420605772285">605 772 285</a></li>
                      <li>Ilona Švárová - <a class="block underline hover:text-blue-700 sm:inline" href="tel:+420602888017">602 888 017</a></li>
                      <li>Jan Hlaváček - <a class="block underline hover:text-blue-700 sm:inline" href="tel:+420603748999">603 748 999</a></li>
                    </ul>
                  </div>
                  <div>
                    <h5><b>E-mail:</b></h5>
                    <ul class="ml-4">
                      <li><a class="break-words underline hover:text-blue-700" href="mailto:autoskola.hlavacek@seznam.cz">autoskola.hlavacek@<wbr />seznam.cz</a></li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="space-y-8 sm:px-8 w-full">
            <!-- styling flex -->

            <div class="w-full mt-10">
              <div class="flex items-center">
                <div
                  class="flex items-center justify-center w-12 h-12 rounded-full bg-primary-500">
                  <Icon name="tabler:map" class="w-7 h-7 text-slate-900" />
                </div>
                <h3 class="mb-3 ml-3 text-xl font-bold">Mapa</h3>
              </div>
              <div class="relative mx-auto mb-4 mt-8 aspect-[4/3] w-full max-w-3xl overflow-hidden rounded-xl">
                <iframe
                  src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d33140.665773965935!2d14.897796999999999!3d49.705245000000005!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x470c88327e0e33d1%3A0x6c30ed645228e93!2zS29tZW5za8OpaG8gNDAsIDI1OCAwMSBWbGHFoWltLCDEjGVza28!5e1!3m2!1scs!2sus!4v1668686750931!5m2!1scs!2sus"
                  title="Mapa autoškoly Hlaváček ve Vlašimi"
                  class="h-full w-full border-0"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"></iframe>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</Layout>
