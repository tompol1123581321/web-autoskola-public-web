---
import Container from "../components/container.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 Not Found">
  <Container>
    <div class="min-h-[calc(100vh-16rem)] flex items-center justify-center">
      <div class="mt-16 text-center">
        <h1 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">404</h1>
        <p class="text-lg mt-4 text-slate-600">Stránka nenalezena.</p>
        <a
          href="/"
          class="mt-8 inline-block rounded bg-black px-5 py-2.5 text-white transition hover:bg-gray-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black">
          Zpět na úvod
        </a>
      </div>
    </div>
  </Container>
</Layout>
