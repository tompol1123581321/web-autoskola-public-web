---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { IMAGE_DATA_HOLDER } from "../../helpers/imageDataHolder";
import "../../styles/global.css";

export function getStaticPaths() {
  return IMAGE_DATA_HOLDER.map((data) => ({ params: { id: String(data.id) } }));
}

const { id } = Astro.params;

const { alt, position, src } = IMAGE_DATA_HOLDER.find(
  (data) => String(data.id) === id
) as any;
const imageLabel = alt || `Fotografie z autoškoly ${Number(id) + 1}`;

const nextImageUrl =
  position === "last" ? `/galerie/${0}` : `/galerie/${Number(id) + 1}`;
const prevImageUrl =
  position === "first"
    ? `/galerie/${IMAGE_DATA_HOLDER.length - 1}`
    : `/galerie/${Number(id) - 1}`;
const homeUrl = "/#gallery";
---

<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{imageLabel} | Galerie Autoškoly Hlaváček</title>
  </head>
  <body class="m-0">
    <div class="relative flex min-h-screen w-full flex-col bg-slate-950 text-slate-100">
  <header class="mx-auto flex h-20 w-full max-w-7xl shrink-0 items-center justify-between border-b border-white/10 px-4 sm:px-8">
    <a
      href={homeUrl}
      id="home"
      class="rounded-lg px-3 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:text-base"
    >
      <Icon name="fa:arrow-left" class="mr-2 inline-block h-4 w-4" aria-hidden="true" />
      Zpět do galerie
    </a>
    <p class="rounded-full bg-white/10 px-3 py-1.5 text-sm font-semibold text-white/80">
      {Number(id) + 1} / {IMAGE_DATA_HOLDER.length}
    </p>
  </header>

  <main class="mx-auto flex w-full max-w-7xl flex-1 touch-pan-y select-none flex-col px-4 py-4 sm:px-8 sm:py-6">
    <figure class="flex min-h-0 flex-1 flex-col gap-4">
      <div class="flex h-[min(72vh,820px)] min-h-[280px] items-center justify-center overflow-hidden rounded-2xl border border-white/10 bg-black/25 p-3 shadow-2xl sm:p-6">
      <Image
        view-transition-name="gallery-image"
        src={src}
        alt={imageLabel}
        quality="max"
        loading="eager"
        class="max-h-full max-w-full rounded-lg object-contain"
      />
      </div>
      <figcaption class="text-center text-base font-medium text-white sm:text-lg">{imageLabel}</figcaption>
    </figure>

    <nav aria-label="Navigace v galerii" class="mt-5 flex items-center justify-between gap-4">
      <a
        id="prev"
        href={prevImageUrl}
        aria-label="Předchozí fotografie"
        title="Předchozí fotografie"
        class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-white/15 bg-white/10 text-white transition hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        <Icon name="fa:arrow-left" class="h-4 w-4" aria-hidden="true" />
      </a>
      <p class="text-center text-sm font-medium text-slate-400">
        {Number(id) + 1} / {IMAGE_DATA_HOLDER.length}
      </p>
      <a
        id="next"
        href={nextImageUrl}
        aria-label="Následující fotografie"
        title="Následující fotografie"
        class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-white/15 bg-white/10 text-white transition hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        <Icon name="fa:arrow-right" class="h-4 w-4" aria-hidden="true" />
      </a>
    </nav>
  </main>

    </div>
  </body>
</html>

<script>
  document.addEventListener("keydown", (event) => {
    if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) {
      return;
    }

    const targetId = {
      ArrowRight: "next",
      ArrowLeft: "prev",
      Escape: "home",
    }[event.key as "ArrowRight" | "ArrowLeft" | "Escape"];

    if (targetId) {
      event.preventDefault();
      document.querySelector<HTMLAnchorElement>(`#${targetId}`)?.click();
    }
  });

  const galleryStage = document.querySelector("main");
  let pointerStartX: number | null = null;

  galleryStage?.addEventListener("pointerdown", (event) => {
    if (event.pointerType === "mouse" && event.button !== 0) return;
    pointerStartX = event.clientX;
  });

  galleryStage?.addEventListener("pointerup", (event) => {
    if (pointerStartX === null) return;

    const horizontalDistance = event.clientX - pointerStartX;
    pointerStartX = null;

    if (Math.abs(horizontalDistance) < 50) return;

    const targetId = horizontalDistance < 0 ? "next" : "prev";
    document.querySelector<HTMLAnchorElement>(`#${targetId}`)?.click();
  });

  galleryStage?.addEventListener("pointercancel", () => {
    pointerStartX = null;
  });

</script>
